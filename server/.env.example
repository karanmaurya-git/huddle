PORT=5000
NODE_ENV=development
# Local MongoDB. For MongoDB Atlas use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/huddle
MONGODB_URI=mongodb://127.0.0.1:27017/huddle
# `npm run setup` (in the project root) replaces this with a random value. Use 32+ characters.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRE=7d
# Exact frontend origin, no trailing slash. Used for CORS and the WebSocket origin check.
CLIENT_URL=http://localhost:5173
MAX_PARTICIPANTS=100

# LiveKit SFU. These are the public DEFAULT credentials of `livekit-server --dev`, for local use only.
# In production create your own key and secret and never reuse these.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
SFU_TOKEN_TTL_SECONDS=600

# Optional: bcrypt cost (default 10)
# BCRYPT_ROUNDS=10

# Optional: raise when running load tests (registering many bots hits the default limit of 100 per 15 min)
# AUTH_RATE_LIMIT_MAX=100
